# === REQUIRED (2 core databases) ===
MEETING_NOTES_DB_ID=your_meeting_notes_db_id
PROJECT_LOG_DB_ID=your_project_log_db_id

# === REQUIRED (for worker exec outside Custom Agent) ===
NOTION_API_TOKEN=ntn_your_token

# === RECOMMENDED (enables edges + action items in graph) ===
RELATIONSHIPS_DB_ID=your_relationships_db_id
ACTION_ITEMS_DB_ID=your_action_items_db_id

# === OPTIONAL (extra databases — features degrade gracefully) ===
CHANGE_LOG_DB_ID=your_change_log_db_id
RECALL_PATHS_DB_ID=your_recall_paths_db_id

# === OPTIONAL (for AI extraction in updateKnowledgeSpine tool) ===
OPENAI_API_KEY=sk-your_key
